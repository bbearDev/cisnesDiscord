{
  "name": "cisnes-discord",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "시스네 디스코드 봇 — 치지직 라이브·유튜브 업로드 공지 및 인증 연동",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/store/migrations && cp src/store/migrations/*.sql dist/store/migrations/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "secrets:scan": "node scripts/secrets-scan.mjs",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "discord.js": "^14.18.0",
    "pino": "^9.6.0",
    "pino-roll": "^3.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.18.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
