# cisnesDiscord 시크릿
#
# 이 파일을 .env 로 복사한 뒤 REQUIRED 를 실제 값으로 바꾸십시오.
# .env 는 .gitignore 로 막혀 있고 .env.example 만 저장소에 남습니다.
#
# ★ 여기 있는 값은 전부 config/config.yaml 에 적으면 안 됩니다.
#   로더가 시크릿으로 보이는 키를 찾으면 기동을 거부합니다.
#   로그에도 남지 않습니다 — src/runtime/redact.ts 가 키 이름과 값 모양
#   두 그물로 가립니다.

# ── 디스코드 ──────────────────────────────────────────────────
# 봇 게이트웨이 토큰. 이것 하나로 봇 계정 전체가 열립니다.
DISCORD_BOT_TOKEN=REQUIRED

# 운영 경보용 웹훅 URL. **선택**입니다 — 비워 두면 경보를 보내지 않을 뿐
# 기동은 정상입니다. URL 자체가 곧 발송 권한이므로 토큰과 같은 등급으로 다룹니다.
#
# ★ 공지(게이트웨이)와 경보(웹훅)를 다른 경로로 두는 이유:
#   게이트웨이가 죽었을 때 그 사실을 알리는 경로가 같은 게이트웨이면
#   아무도 그 장애를 모릅니다.
DISCORD_OPS_WEBHOOK_URL=

# ── chzzkbot 연동 ─────────────────────────────────────────────
# chzzkbot → 우리. POST /hooks/chzzkbot/live 수신 시 상수 시간 비교로 검증합니다 (AC-14).
# chzzkbot 쪽 .env 의 같은 이름 값과 일치해야 합니다.
LIVE_EVENT_WEBHOOK_TOKEN=REQUIRED

# 우리 → chzzkbot. GET /api/live 호출 시 x-chzzkbot-token 헤더로 싣습니다.
#
# ★★ 계약 §2 경고: 이 토큰은 **운영자 전용이며 chzzkbot 에 등록된 모든 채널을 엽니다.**
#    봇 토큰과 같은 등급으로 다루십시오. 위 웹훅 토큰과는 다른 값입니다.
LIVE_API_TOKEN=REQUIRED

# ── 치지직 OAuth (시청자 인증) ────────────────────────────────
# ★★ chzzkbot 과 **같은 clientId 를 쓰면 안 됩니다** (계획 §5.2-c 불변식).
#    같으면 시청자 인증 1건의 revoke 가 chzzkbot 스트리머 토큰을 죽여
#    팔로워 검증이 전원 정지합니다. 기계로 검사할 수 없으니
#    (상대 값을 우리가 모릅니다) 배포 전에 눈으로 대조하십시오.
CHZZK_CLIENT_ID=REQUIRED
CHZZK_CLIENT_SECRET=REQUIRED
