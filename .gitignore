# ── 비밀값 ────────────────────────────────────────────────────
# 실제 자격 증명이 든 파일. .env.example 만 저장소에 남깁니다.
.env
.env.*
!.env.example


# ── 런타임 데이터 ─────────────────────────────────────────────
# DB, 락, 하트비트, 로그. 전부 여기 아래에 모입니다.
data/


# ── 백업 ──────────────────────────────────────────────────────
backup/


# ── 실제 설정 파일 ────────────────────────────────────────────
# 예시 파일만 저장소에 남기고, 채워 넣은 실물은 제외합니다.
config/config.yaml
config/*.local.yaml


# ── 실측 캡처 ★ ───────────────────────────────────────────────
# 스파이크(S1)·계약 실호출의 요청·응답 **원문**에는 토큰이 들어갑니다.
# test/fixtures/chzzkbot·youtube 의 합성 계약 픽스처는 대상이 아닙니다 —
# 그건 손으로 쓴 것이라 비밀값이 없고, 테스트가 의존하므로 추적해야 합니다.
#
# ⚠️ 디렉터리 자체를 제외하면 git 이 그 안의 파일을 되살리지 못해
#    마스킹본까지 함께 차단됩니다. 그래서 디렉터리가 아니라
#    "안의 항목"(/*)을 제외하고 예외를 겁니다 (chzzkbot US-002 에서 실제로 밟은 함정).
test/fixtures/captures/*
!test/fixtures/captures/*.masked.json

# 픽스처 백업 디렉터리 — chzzkbot 에서 실제로 여기에 Bearer 원문이 남아 있었고
# 본체만 막고 백업을 안 막아 삭제한 줄 알았던 값이 백업 경로로 커밋됐습니다.
test/fixtures/.prev/
test/fixtures/**/.prev/


# ── 워치독 환경파일 ───────────────────────────────────────────
*watchdog.env


# ── OMC 작업 상태 ─────────────────────────────────────────────
.omc/


# ── 개발 작업 로그 ────────────────────────────────────────────
progress.txt


# ── Node.js ───────────────────────────────────────────────────
node_modules/
dist/
build/
*.tsbuildinfo
coverage/
.nyc_output/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*


# ── 에디터 · OS ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
.tmp-*
